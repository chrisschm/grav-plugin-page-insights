{
    "name": "chschmidt/page-insights",
    "type": "grav-plugin",
    "description": "Enhaced statistics for grav.",
    "keywords": [
        "plugin"
    ],
    "homepage": "https://codeberg.org/chschmidt/grav-plugin-page-insights",
    "license": "MIT",
    "authors": [
        {
            "name": "Nuno Costa",
            "email": "info@codehaha.com",
            "role": "Original Author"
        },
        {
            "name": "Christian Schmidt",
            "email": "christian.schmidt@jcs-net.de",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-sqlite3": "*",
        "ext-pdo": "*"
    },
    "suggest": {
        "ext-curl": "Used to download the RIR delegated-stats snapshot when (re)building the geo country index; falls back to file_get_contents() if unavailable."
    },
    "autoload": {
        "psr-4": {
            "Grav\\Plugin\\PageInsights\\": "classes/"
        },
        "classmap": [
            "page-insights.php"
        ]
    },
    "config": {
        "platform": {
            "php": "8.0"
        },
        "autoloader-suffix": "PageInsightsGravPlugin"
    },
    "version": "3.0.1"
}
