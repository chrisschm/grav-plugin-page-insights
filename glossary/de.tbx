<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE martif PUBLIC "ISO 12200:1999A//DTD MARTIF core (DXFcdV04)//EN" "TBXcdv04.dtd">
<martif type="TBX" xml:lang="en">
    <martifHeader>
        <fileDesc>
            <sourceDesc>
                <p>Weblate Glossary</p>
            </sourceDesc>
        </fileDesc>
    </martifHeader>
    <text>
        <body>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Page Insights</term></tig></langSet>
                <langSet xml:lang="de"><tig><term/></tig></langSet>
                <descrip>Name: The name of the application must not be translated.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Grav</term></tig></langSet>
                <langSet xml:lang="de"><tig><term></term></tig></langSet>
                <descrip>Name: Grav must not be translated as the name of the CMS.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>1.7</term></tig></langSet>
                <langSet xml:lang="de"><tig><term></term></tig></langSet>
                <descrip>Version: Version numbers must be adopted.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>1.x</term></tig></langSet>
                <langSet xml:lang="de"><tig><term></term></tig></langSet>
                <descrip>Version: Version numbers must be adopted.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>2.0</term></tig></langSet>
                <langSet xml:lang="de"><tig><term></term></tig></langSet>
                <descrip>Version: Version numbers must be adopted.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Admin2</term></tig></langSet>
                <langSet xml:lang="de"><tig><term></term></tig></langSet>
                <descrip>Name: The name of the admin plugin must not be translated.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>HTTP</term></tig></langSet>
                <langSet xml:lang="de"><tig><term></term></tig></langSet>
                <descrip>Technical term: Hypertext Transfer Protocol. Keep as "HTTP" in all languages — do not translate.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>URL</term></tig></langSet>
                <langSet xml:lang="de"><tig><term></term></tig></langSet>
                <descrip>Technical term: Uniform Resource Locator. Keep as "URL" in all languages — do not translate.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>%s</term></tig></langSet>
                <langSet xml:lang="de"><tig><term></term></tig></langSet>
                <descrip>Variable: Placeholders (%s) must not be translated.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>user/pages</term></tig></langSet>
                <langSet xml:lang="de"><tig><term></term></tig></langSet>
                <descrip>Path: File paths must not be translated.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>sitemap.xml</term></tig></langSet>
                <langSet xml:lang="de"><tig><term></term></tig></langSet>
                <descrip>Path: File paths must not be translated.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>robots.txt</term></tig></langSet>
                <langSet xml:lang="de"><tig><term></term></tig></langSet>
                <descrip>Path: File paths must not be translated.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>bin/grav scheduler</term></tig></langSet>
                <langSet xml:lang="de"><tig><term></term></tig></langSet>
                <descrip>Technical term: commands must not be translated.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>bin/plugin page-insights rollup:build --from=</term></tig></langSet>
                <langSet xml:lang="de"><tig><term></term></tig></langSet>
                <descrip>Technical term: commands must not be translated.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>rollup:build</term></tig></langSet>
                <langSet xml:lang="de"><tig><term></term></tig></langSet>
                <descrip>Technical term: commands must not be translated.</descrip>
            </termEntry>
        </body>
    </text>
</martif>
